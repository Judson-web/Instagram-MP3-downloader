{
  "name": "instagram-mp3-downloader",
  "version": "2.0.0",
  "private": true,
  "description": "An accessible Instagram Reel to MP3 converter with four bitrate presets and temporary browser downloads.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "npm run check && tsc -p tsconfig.json && cp dist/server.js server.js && cp dist/client.js public/app.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.2",
    "express": "4.21.2",
    "ffmpeg-static": "5.2.0",
    "helmet": "8.1.0",
    "youtube-dl-exec": "3.1.17"
  },
  "allowScripts": {
    "youtube-dl-exec@3.1.17": true,
    "ffmpeg-static@5.2.0": true
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  },
  "license": "Apache-2.0"
}
