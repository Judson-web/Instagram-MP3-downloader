{
  "name": "instagram-mp3-downloader",
  "version": "1.1.1",
  "private": true,
  "description": "ReelTone converts public Instagram Reel URLs into MP3 audio.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check public/app.js",
    "build": "npm run check"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.2",
    "express": "4.21.2",
    "ffmpeg-static": "5.2.0",
    "helmet": "8.1.0",
    "youtube-dl-exec": "3.1.17"
  },
  "allowScripts": {
    "youtube-dl-exec@3.1.17": true,
    "ffmpeg-static@5.2.0": true
  }
}
