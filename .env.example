# Required for shared rate limits, health checks and shared upstream cooldowns
DATABASE_URL=

# Required in production: cryptographically random secret with at least 32 bytes
RATE_LIMIT_SECRET=

# Preferred extractor. Use a dedicated Cobalt API instance you control or trust.
# The submitted Instagram URL is sent to this provider first when configured.
COBALT_API_URL=
COBALT_API_KEY_V2=
# Compatibility alias; COBALT_API_KEY_V2 takes precedence when both are set.
COBALT_API_KEY=

# Optional comma- or newline-separated failover endpoints.
# Each endpoint must accept the same Cobalt API key; only transport/download failures trigger failover.
COBALT_API_FALLBACK_URLS=

# Optional generic resolver. Unset by default.
MEDIA_RESOLVER_URL=

# Optional, paid public-Reel extraction fallback (server-side only).
# Apify token is sent only to api.apify.com; each run is capped to $0.05 / 1 result.
APIFY_API_TOKEN=

# Optional provider. Unset by default.
EASYDOWN_API_TOKEN=

# Vercel Cron authorization secret for daily private audio-cache expiry
CRON_SECRET=

# Provisioned automatically by the connected private Vercel Blob store
BLOB_READ_WRITE_TOKEN=
