# Required for shared rate limits, health checks, and shared upstream cooldowns
DATABASE_URL=

# Required in production: cryptographically random secret with at least 32 bytes
RATE_LIMIT_SECRET=

# Optional. Unset by default so submitted links are not sent to a third-party resolver.
# Configure only a trusted HTTPS endpoint after reviewing its data-handling policies.
MEDIA_RESOLVER_URL=

# Optional. Enables EasyDown after a direct Instagram attempt.
# When enabled, the submitted Instagram URL is sent to EasyDown for media lookup.
EASYDOWN_API_TOKEN=
