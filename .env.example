# Required for shared rate limits, health checks and shared upstream cooldowns
DATABASE_URL=

# Required in production: cryptographically random secret with at least 32 bytes
RATE_LIMIT_SECRET=

# Optional but recommended fallback. A dedicated Cobalt API instance, not a public shared instance.
# ReelTone sends the submitted URL only after direct Instagram page/embed extraction fails.
COBALT_API_URL=
COBALT_API_KEY=

# Optional generic resolver. Unset by default.
MEDIA_RESOLVER_URL=

# Optional provider. Unset by default.
EASYDOWN_API_TOKEN=
